rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each user can only read/write their own progress document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
